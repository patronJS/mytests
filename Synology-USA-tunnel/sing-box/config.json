{
  "log": {
    "level": "warn",
    "timestamp": true
  },

  "inbounds": [
    {
      "type": "mixed",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],

  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "<YOUR_VPS_IP>",
      "server_port": 443,
      "uuid": "<YOUR_UUID>",
      "tls": {
        "enabled": true,
        "server_name": "<YOUR_SNI>",
        "reality": {
          "enabled": true,
          "public_key": "<YOUR_REALITY_PUBLIC_KEY>",
          "short_id": "<YOUR_SHORT_ID>"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "firefox"
        }
      }
    }
  ],

  "route": {
    "final": "proxy"
  }
}
